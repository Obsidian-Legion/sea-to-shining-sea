-- Sea to Shining Sea. Content, data, HTML composition, and page generation in Unison.
-- CSS and a small progressive-enhancement script are copied from public/.
use Text ++

sea.escape : Text -> Text
sea.escape value =
  value
    |> Text.replaceAll "&" "&amp;"
    |> Text.replaceAll "<" "&lt;"
    |> Text.replaceAll ">" "&gt;"
    |> Text.replaceAll "\"" "&quot;"

sea.baseUrl : Text
sea.baseUrl = "https://Obsidian-Legion.github.io/sea-to-shining-sea/"

sea.header : Text
sea.header =
  """
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <a class="brand" href="index.html" aria-label="Sea to Shining Sea home"><img src="assets/mark.svg" width="42" height="42" alt=""><span>SEA TO SHINING SEA<small>AN OBSIDIAN LEGION FIELD JOURNAL</small></span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navigation">Menu <span aria-hidden="true">+</span></button>
    <nav id="navigation" aria-label="Main navigation"><a href="index.html#dispatches">Dispatches</a><a href="index.html#the-map">The map</a><a href="index.html#the-mission">The mission</a><a class="nav-button" href="index.html#follow">Follow the journey <span aria-hidden="true">↗</span></a></nav>
  </header>
  """

sea.footer : Text
sea.footer =
  """
  <footer class="site-footer wrap">
    <div class="footer-top"><a class="footer-wordmark" href="index.html">Sea to <em>shining sea.</em></a><p>A country of stories.<br>Stay for the whole picture.</p><a class="back-top" href="#top" aria-label="Back to top">↑</a></div>
    <div class="footer-bottom"><p>© 2026 OBSIDIAN LEGION</p><div><a href="editorial.html">Editorial standards</a><a href="https://github.com/Obsidian-Legion/sea-to-shining-sea">Source ↗</a><a href="https://www.unison-lang.org/">Built with Unison ↗</a></div><p>FROM COAST TO COAST.</p></div>
  </footer>
  <noscript><style>.menu-toggle,.filter-bar,.map-pins,.copy-link{display:none!important}@media(max-width:800px){.site-header{flex-wrap:wrap;gap:20px;height:auto;padding-block:20px}.site-header nav{display:flex!important;position:static;flex-wrap:wrap;background:transparent;padding:0;width:100%}}</style></noscript>
  """

sea.document : Text -> Text -> Text -> Text -> Text
sea.document file title description body =
  "<!doctype html><html lang=\"en\" id=\"top\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"theme-color\" content=\"#122a2c\">"
    ++ "<title>" ++ sea.escape title ++ "</title><meta name=\"description\" content=\"" ++ sea.escape description ++ "\">"
    ++ "<link rel=\"canonical\" href=\"" ++ sea.baseUrl ++ (if file == "index.html" then "" else file) ++ "\">"
    ++ "<meta property=\"og:title\" content=\"" ++ sea.escape title ++ "\"><meta property=\"og:description\" content=\"" ++ sea.escape description ++ "\"><meta property=\"og:type\" content=\"website\">"
    ++ "<meta property=\"og:url\" content=\"" ++ sea.baseUrl ++ (if file == "index.html" then "" else file) ++ "\"><meta property=\"og:image\" content=\"" ++ sea.baseUrl ++ "assets/ocean.jpg\"><meta name=\"twitter:card\" content=\"summary_large_image\">"
    ++ "<link rel=\"icon\" href=\"assets/mark.svg\" type=\"image/svg+xml\"><link rel=\"stylesheet\" href=\"styles.css\"><script src=\"site.js\" defer></script></head><body>"
    ++ sea.header ++ "<main id=\"main\">" ++ body ++ "</main>" ++ sea.footer ++ "</body></html>"

-- Each dispatch is an explicitly labeled editorial concept, not invented reporting.
structural type Dispatch = Dispatch Text Text Text Text Text Text Text Text

sea.borderStory : Dispatch
sea.borderStory =
  Dispatch "borderlands" "Borderlands" "Where the line becomes a life."
    "Beyond the politics of a border, the everyday work of making a home."
    "heartland.jpg" "A two-lane road winding through red rock country" "01"
    """
    <p class="article-lead">A line on a map can look simple. The lives around it rarely are.</p>
    <p>This reporting brief begins with a question: what does a border mean to the people who live beside it? A workplace. A family connection. A daily crossing. A boundary that shapes ordinary decisions long before those decisions become a national argument.</p>
    <h2>Begin with the people.</h2>
    <p>The proposed assignment is to follow the rhythms of a border community through the people who keep it moving: residents, business owners, aid workers, and public officials. Their accounts should be heard in context, checked against records, and allowed to complicate a familiar story.</p>
    <blockquote>The most useful question may be the simplest: what does an ordinary day ask of you?</blockquote>
    <h2>What the reporting would ask.</h2>
    <p>How do policy changes reach a household? What is visible from a distance, and what disappears? Which voices are quoted often, and whose experience is still missing from the record?</p>
    <p>Those questions are a starting point. An answer belongs on this page only after the reporting has earned it.</p>
    """

sea.heartStory : Dispatch
sea.heartStory =
  Dispatch "heartland" "Heartland" "The places between the headlines."
    "Work, belonging, and the communities too often described from a distance."
    "landscape.jpg" "The sun rising above layers of wooded hills" "02"
    """
    <p class="article-lead">Most of a country's life happens between the moments that make the news.</p>
    <p>This is a brief for slow reporting on work and belonging: the decisions made around kitchen tables, the places where neighbors meet, and the institutions that turn a collection of addresses into a community.</p>
    <h2>Stay past the first impression.</h2>
    <p>The proposed assignment starts with a place, not a predetermined conclusion. Return to it. Learn its vocabulary. Ask who has stayed, who has left, and what each person believes the national conversation misses.</p>
    <blockquote>A place is more than the argument someone wants it to represent.</blockquote>
    <h2>Follow the local record.</h2>
    <p>Public meeting minutes, local archives, employment records, and on-the-record interviews would form the backbone of the work. A personal account can open a story; it cannot, by itself, establish a trend.</p>
    <p>The aim is a portrait with enough room for disagreement, dignity, and the details that refuse to fit a slogan.</p>
    """

sea.appalachiaStory : Dispatch
sea.appalachiaStory =
  Dispatch "appalachia" "Appalachia" "What remains. What comes next."
    "A reporting brief on memory, resilience, and the meaning of staying."
    "mountains.jpg" "Layers of green mountains beneath low mist" "03"
    """
    <p class="article-lead">To understand a place, ask what its people are trying to keep—and what they are ready to change.</p>
    <p>This proposed series looks at the relationship between landscape, livelihood, and memory. Its starting point is the conviction that a community deserves to be understood on its own terms.</p>
    <h2>Beyond a familiar photograph.</h2>
    <p>A landscape can be beautiful and a livelihood uncertain. A town can carry a difficult history and still be a place of invention. Good reporting has to hold more than one truth in view.</p>
    <blockquote>Staying can be a decision, an obligation, a hope—or all three.</blockquote>
    <h2>The questions ahead.</h2>
    <p>What opportunities do young people see? How do local organizers define recovery? Which promises can be measured against public records? And how do residents want the next chapter of their home to be told?</p>
    <p>Specific locations and sources will be identified when reporting begins. This page is an editorial direction, not a claim to have completed that work.</p>
    """

sea.coastStory : Dispatch
sea.coastStory =
  Dispatch "coastlines" "Coastlines" "At the edge, looking inward."
    "Two oceans. Many communities. One question about the future of home."
    "ocean.jpg" "Blue ocean waves at water level" "04"
    """
    <p class="article-lead">An ocean is an edge on a map. For the people beside it, it is the center of daily life.</p>
    <p>This proposed coast-to-coast assignment would examine how people understand home in places shaped by water: through work, public access, housing, and the choices communities make about their future.</p>
    <h2>Look inland, too.</h2>
    <p>The view from the shoreline tells only part of a story. A complete account would follow the connections between coastal towns and the places that supply, sustain, and depend on them.</p>
    <blockquote>The coast is where the country meets the horizon. The story reaches much farther.</blockquote>
    <h2>A record readers can follow.</h2>
    <p>Future dispatches would distinguish observation from interpretation, link to public documents where possible, and make clear what remains unknown. The goal is work a reader can return to and examine.</p>
    <p>For now, this is the opening of a notebook: a direction of travel, and an invitation to look more closely.</p>
    """

sea.stories : [Dispatch]
sea.stories = [sea.borderStory, sea.heartStory, sea.appalachiaStory, sea.coastStory]

sea.card : Dispatch -> Text
sea.card story =
  match story with
    Dispatch slug region title deck image alt number _ ->
      "<article class=\"dispatch-card\" data-region=\"" ++ slug ++ "\"><a class=\"card-image\" href=\"" ++ slug ++ ".html\" tabindex=\"-1\" aria-hidden=\"true\"><img src=\"assets/" ++ image ++ "\" alt=\"\" width=\"700\" height=\"520\" loading=\"lazy\"><span class=\"image-index\">FIELD FILE / " ++ number ++ "</span><span class=\"image-arrow\" aria-hidden=\"true\">↗</span></a>"
        ++ "<div class=\"card-meta mono\"><span>" ++ region ++ "</span><span>REPORTING BRIEF</span></div><h3><a href=\"" ++ slug ++ ".html\">" ++ sea.escape title ++ "</a></h3><p>" ++ sea.escape deck ++ "</p><a class=\"card-link\" href=\"" ++ slug ++ ".html\">Read the brief <span aria-hidden=\"true\">↗</span></a></article>"

sea.mapEntry : Dispatch -> Text
sea.mapEntry story =
  match story with
    Dispatch slug region title deck _ _ number _ ->
      "<article class=\"map-entry\" id=\"map-" ++ slug ++ "\"" ++ (if slug == "borderlands" then "" else " hidden") ++ "><p class=\"eyebrow\">FIELD FILE " ++ number ++ " / " ++ region ++ "</p><h3>" ++ sea.escape title ++ "</h3><p>" ++ sea.escape deck ++ "</p><a class=\"text-link\" href=\"" ++ slug ++ ".html\">Open the reporting brief <span aria-hidden=\"true\">↗</span></a><span class=\"map-note mono\">PROPOSED COVERAGE · EDITORIAL CONCEPT</span></article>"

sea.map : Text
sea.map =
  """
  <section class="map-section" id="the-map" aria-labelledby="map-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow"><span class="tiny-cross">+</span> 02 / THE GEOGRAPHY OF A STORY</p><h2 id="map-title">One country.<br><em>A thousand fault lines.</em></h2></div><p>Look beyond the dateline.<br>Explore the places behind the reporting.</p></div>
    <div class="map-layout"><div class="map-art">
    <span class="map-coordinate mono">CONTIGUOUS UNITED STATES / SCHEMATIC</span>
    <svg class="us-map" viewBox="0 0 800 500" role="img" aria-label="Schematic map of the continental United States with four planned coverage regions">
      <defs><pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M 40 0 L 0 0 0 40" fill="none" stroke="#c8dcc7" stroke-opacity=".09" stroke-width="1"/></pattern><pattern id="dots" width="9" height="9" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1" fill="#a7b9a5" opacity=".45"/></pattern></defs>
      <rect width="800" height="500" fill="url(#grid)"/>
      <path class="nation" d="M91 83 L154 101 209 113 270 123 328 127 382 130 432 130 451 150 472 142 492 163 514 162 525 181 541 170 551 137 573 151 587 135 600 151 592 172 605 190 628 188 653 173 668 155 699 143 712 120 730 121 739 103 749 112 745 144 729 168 728 190 714 206 699 224 685 247 663 262 654 286 636 304 614 315 593 339 605 365 615 393 613 414 601 423 588 402 578 372 564 352 539 347 511 350 495 337 477 351 444 351 430 362 414 348 408 372 391 399 365 385 350 360 330 346 314 347 306 325 277 330 248 319 218 308 195 303 177 281 157 273 145 251 126 234 115 211 105 192 96 164 88 140 91 115 84 105Z" fill="url(#dots)" stroke="#849c8d" stroke-width="1.5"/>
      <g fill="none" stroke="#849c8d" stroke-opacity=".3" stroke-width="1"><path d="m150 102-23 131m82-120-30 169m91-159-18 197m75-193-9 222m65-220 1 249m48-247 6 221m43-189 13 176m-378-184 304 29m-282 41 429 8m-403 45 342 7m-301 37 356 0"/></g>
      <path d="M129 198 Q228 331 294 310 T460 240 T596 275 Q655 261 680 219" fill="none" stroke="#dce7af" stroke-width="1.5" stroke-dasharray="5 7" opacity=".55"/>
      <g class="ocean-labels" fill="#8fa6a0" font-size="11" letter-spacing="4"><text x="34" y="320" transform="rotate(-65 34 320)">PACIFIC OCEAN</text><text x="710" y="355" transform="rotate(-65 710 355)">ATLANTIC OCEAN</text></g>
      <g transform="translate(700 55)" fill="none" stroke="#dce7af"><circle r="20" opacity=".4"/><path d="M0-30V30M-30 0H30" opacity=".4"/><path d="m0-17 5 17-5-4-5 4z" fill="#dce7af"/></g><text x="696" y="15" fill="#dce7af" font-size="10">N</text>
    </svg>
    <div class="map-pins" role="group" aria-label="Choose a coverage region"><button class="map-pin pin-borderlands active" type="button" data-map="borderlands" aria-pressed="true" aria-controls="map-borderlands"><span class="pin-dot"></span><span>Borderlands</span></button><button class="map-pin pin-heartland" type="button" data-map="heartland" aria-pressed="false" aria-controls="map-heartland"><span class="pin-dot"></span><span>Heartland</span></button><button class="map-pin pin-appalachia" type="button" data-map="appalachia" aria-pressed="false" aria-controls="map-appalachia"><span class="pin-dot"></span><span>Appalachia</span></button><button class="map-pin pin-coastlines" type="button" data-map="coastlines" aria-pressed="false" aria-controls="map-coastlines"><span class="pin-dot"></span><span>Coastlines</span></button></div>
    <p class="map-legend mono"><span></span> SELECT A REGION TO EXPLORE <span class="legend-line"></span> A DIRECTION, NOT A LIVE ROUTE</p>
    </div><div class="map-details" aria-live="polite">
  """
    ++ Text.join "" (List.map sea.mapEntry sea.stories)
    ++ "</div></div></div></section>"

sea.homeBody : Text
sea.homeBody =
  """
  <section class="hero" aria-labelledby="hero-title">
    <img class="hero-ocean" src="assets/ocean.jpg" alt="" width="2200" height="1467" fetchpriority="high">
    <div class="hero-shade"></div>
    <div class="hero-content wrap"><div class="hero-topline"><p class="eyebrow"><span class="status-dot"></span> INDEPENDENT EYES. AMERICAN GROUND.</p><span class="mono hero-volume">VOL. 01 / THE OPENING CHAPTER</span></div>
      <div class="hero-main"><div class="hero-copy"><h1 id="hero-title">Sea to<br><em>shining sea.</em></h1><p class="hero-description">The front lines aren't always far from home.<br>Stories of a country divided. And the people<br class="wide-break"> who still hold it together.</p><a class="button button-lime" href="#dispatches">Explore the dispatches <span aria-hidden="true">↗</span></a></div>
      <aside class="hero-note"><span class="note-cross" aria-hidden="true">+</span><p class="mono">THE ASSIGNMENT</p><p>Go closer.<br>Stay longer.<br><em>Tell it straight.</em></p><a href="#the-mission">A note from Obsidian Legion <span aria-hidden="true">↗</span></a></aside></div>
      <div class="hero-bottom mono"><span>DOMESTIC CONFLICT. HUMAN CONSEQUENCES.</span><a href="#dispatches">SCROLL TO BEAR WITNESS <span aria-hidden="true">↓</span></a><span>EST. 2026</span></div>
    </div>
  </section>
  <div class="ticker" aria-label="Our editorial principles"><div><span>ON THE GROUND</span><i>✳</i><span>BEYOND THE HEADLINES</span><i>✳</i><span>PEOPLE BEFORE POLITICS</span><i>✳</i><span>FROM COAST TO COAST</span><i>✳</i><span>THE WHOLE PICTURE</span><i>✳</i></div></div>
  <section class="dispatches wrap" id="dispatches" aria-labelledby="dispatch-title"><div class="section-heading"><div><p class="eyebrow"><span class="tiny-cross">+</span> 01 / THE FIELD JOURNAL</p><h2 id="dispatch-title">From the <em>fault lines.</em></h2></div><p>Closer to the ground.<br>Further than the news cycle.</p></div>
    <div class="dispatch-toolbar"><div class="filter-bar" role="group" aria-label="Filter reporting briefs"><button type="button" class="active" data-filter="all" aria-pressed="true">All dispatches <span>04</span></button><button type="button" data-filter="borderlands" aria-pressed="false">Borderlands</button><button type="button" data-filter="heartland" aria-pressed="false">Heartland</button><button type="button" data-filter="appalachia" aria-pressed="false">Appalachia</button><button type="button" data-filter="coastlines" aria-pressed="false">Coastlines</button></div><span class="mono preview-label">PREVIEW EDITION</span></div>
    <p class="sr-only" id="filter-status" role="status">Showing 4 reporting briefs.</p><div class="dispatch-grid">
  """
    ++ Text.join "" (List.map sea.card sea.stories)
    ++ """
    </div><div class="editorial-note"><span class="mono">A NOTE ON THIS EDITION</span><p>These are editorial concepts for future coverage, not published field reports. Landscape photography sets the scene; it does not document the events described. <a href="editorial.html">Our standards ↗</a></p></div>
  </section>
  """
    ++ sea.map
    ++ """
  <section class="mission wrap" id="the-mission" aria-labelledby="mission-title"><div class="mission-heading"><p class="eyebrow"><span class="tiny-cross">+</span> 03 / THE MISSION</p><h2 id="mission-title">The country is<br>the <em>assignment.</em></h2><div class="byline"><img src="assets/mark.svg" alt="" width="45" height="45"><div><strong>Obsidian Legion</strong><span class="mono">AN INDEPENDENT EDITORIAL PROJECT</span></div></div></div><div class="mission-copy"><p class="mission-lead">There is a distance between the America we argue about and the America we live in.</p><p>Sea to Shining Sea is a home for domestic war correspondence: a close look at conflict, civic fracture, and the lives caught in between. The ambition is to meet people where they are, follow the evidence, and stay with a story after the attention moves on.</p><p>Every place is somebody's home. Every person deserves more than a role in someone else's argument. That's where the work begins.</p><a class="text-link" href="editorial.html">Read the editorial commitment <span aria-hidden="true">↗</span></a></div></section>
  <section class="quote-section"><div class="wrap"><span class="quote-mark" aria-hidden="true">“</span><blockquote>To understand a country,<br>you have to <em>get close.</em></blockquote><p class="mono">THE SEA TO SHINING SEA EDITORIAL COMMITMENT</p></div></section>
  <section class="follow wrap" id="follow" aria-labelledby="follow-title"><div><p class="eyebrow"><span class="tiny-cross">+</span> KEEP THE JOURNEY GOING</p><h2 id="follow-title">Stay with <em>the story.</em></h2><p>Follow the publication as it takes shape.<br>Bring someone else along for the journey.</p></div><div class="follow-actions"><a class="button button-dark" href="https://github.com/Obsidian-Legion/sea-to-shining-sea" target="_blank" rel="noopener noreferrer">Follow on GitHub <span aria-hidden="true">↗</span></a><button class="button button-outline copy-link" type="button" data-copy="home">Share the journal <span aria-hidden="true">↗</span></button><p class="follow-note mono">GITHUB SIGN-IN REQUIRED TO WATCH FOR UPDATES.</p><p class="copy-status" role="status"></p></div></section>
  """

sea.article : Dispatch -> Text
sea.article story =
  match story with
    Dispatch slug region title deck image alt number body ->
      sea.document (slug ++ ".html") (title ++ " — Sea to Shining Sea") deck
        ("<article><header class=\"article-header wrap\"><a class=\"article-back mono\" href=\"index.html#dispatches\">← BACK TO THE FIELD JOURNAL</a><p class=\"eyebrow\">FIELD FILE " ++ number ++ " / " ++ region ++ "</p><h1>" ++ sea.escape title ++ "</h1><p class=\"article-deck\">" ++ sea.escape deck ++ "</p><div class=\"article-meta mono\"><span>BY OBSIDIAN LEGION</span><span>EDITORIAL CONCEPT / 3 MIN READ</span><button type=\"button\" class=\"copy-link article-share\" data-copy=\"current\">Share this brief ↗</button></div><p class=\"copy-status\" role=\"status\"></p></header>"
          ++ "<figure class=\"article-cover wrap\"><img src=\"assets/" ++ image ++ "\" alt=\"" ++ sea.escape alt ++ "\" width=\"1400\" height=\"850\" fetchpriority=\"high\"><figcaption class=\"mono\">LANDSCAPE PHOTOGRAPHY / ILLUSTRATIVE, NOT DOCUMENTARY</figcaption></figure>"
          ++ "<div class=\"article-body\"><aside class=\"preview-notice\"><strong>From the opening notebook.</strong> This is a proposed reporting brief, not a completed field report. No interviews or on-location observations are represented as having taken place.</aside>" ++ body
          ++ "<div class=\"article-signoff\"><img src=\"assets/mark.svg\" width=\"48\" height=\"48\" alt=\"\"><p>Obsidian Legion<span>Sea to Shining Sea / The field journal</span></p></div><a class=\"text-link\" href=\"editorial.html\">How this journal approaches the work ↗</a></div></article><section class=\"related wrap\"><p class=\"eyebrow\">KEEP EXPLORING</p><h2>The next <em>horizon.</em></h2><div class=\"dispatch-grid\">"
          ++ Text.join "" (List.map sea.card (List.filter (s -> match s with Dispatch key _ _ _ _ _ _ _ -> not (key == slug)) sea.stories))
          ++ "</div></section>")

sea.editorialBody : Text
sea.editorialBody =
  """
  <article><header class="article-header wrap"><a class="article-back mono" href="index.html">← BACK TO THE JOURNAL</a><p class="eyebrow">THE EDITORIAL COMMITMENT</p><h1>Go closer.<br><em>Tell it straight.</em></h1><p class="article-deck">The standards this publication intends to earn, one story at a time.</p></header><div class="article-body editorial-body"><p class="article-lead">Sea to Shining Sea is an independent editorial project by Obsidian Legion, created as a home for domestic war correspondence.</p><p>Here, that means examining conflict and civic fracture through their human consequences. It is a purpose for reporting, not a claim that the United States is formally at war.</p><h2>Evidence before a conclusion.</h2><p>Future reporting should make its sources and methods clear, distinguish firsthand observation from attributed accounts, and identify what could not be independently verified. An editorial brief is a plan for that work; it is not evidence that the work has taken place.</p><h2>People before a narrative.</h2><p>People deserve context, accurate attribution, and room to be more complicated than a headline. The journal's ambition is to listen carefully, seek relevant responses, and avoid turning a vulnerable person's experience into spectacle.</p><h2>A visible record.</h2><p>Reported pieces should carry a byline, publication date, and any material updates. Substantive corrections should explain what changed and why. Opinion, analysis, reporting briefs, and reported work should be clearly distinguished.</p><h2>About this preview edition.</h2><p>The four field files are original editorial concepts for future coverage. They contain no purported interviews, verified incidents, or claims of completed assignments. The site currently has no published field reporting, news subscription service, or confidential tip channel.</p><h2>Photography and design.</h2><p>The landscapes are illustrative stock photography from Unsplash. They are not photographs of the proposed assignments or evidence of events. Image sources: <a href="https://images.unsplash.com/photo-1518837695005-2083093ee35b">ocean</a>, <a href="https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05">mountains</a>, <a href="https://images.unsplash.com/photo-1500534623283-312aade485b7">open landscape</a>, and <a href="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee">open road</a>. The map is a schematic of proposed coverage, not a live location tracker.</p><h2>Privacy and getting in touch.</h2><p>This website contains no analytics scripts, advertising pixels, contact forms, or third-party font requests. GitHub Pages serves the site and may process access logs under its own policies. Links to GitHub and other websites leave this site.</p><p>For website feedback, use the <a href="https://github.com/Obsidian-Legion/sea-to-shining-sea/issues">public repository issues</a>. Issues are public; do not use them for confidential material or sensitive source information. A dedicated reporting contact can be added when one is established.</p><div class="article-signoff"><img src="assets/mark.svg" alt="" width="48" height="48"><p>Obsidian Legion<span>From coast to coast. Closer to the truth.</span></p></div></div></article>
  """

sea.main : '{IO, Exception} ()
sea.main = do printLine (sea.document "index.html" "Sea to Shining Sea — An Obsidian Legion Field Journal" "Independent eyes. American ground. A domestic correspondent's field journal on conflict, community, and the country between two oceans." sea.homeBody)

sea.borderlands : '{IO, Exception} ()
sea.borderlands = do printLine (sea.article sea.borderStory)

sea.heartland : '{IO, Exception} ()
sea.heartland = do printLine (sea.article sea.heartStory)

sea.appalachia : '{IO, Exception} ()
sea.appalachia = do printLine (sea.article sea.appalachiaStory)

sea.coastlines : '{IO, Exception} ()
sea.coastlines = do printLine (sea.article sea.coastStory)

sea.editorial : '{IO, Exception} ()
sea.editorial = do printLine (sea.document "editorial.html" "The Editorial Commitment — Sea to Shining Sea" "The evidence, attribution, transparency, and privacy commitments behind the Sea to Shining Sea field journal." sea.editorialBody)
